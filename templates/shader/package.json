{
	"name": "svelte-draw-shader-starter-kit",
	"private": true,
	"version": "0.0.0",
	"author": "billyribeiro-ux",
	"homepage": "https://svelte-draw.invalid",
	"license": "MIT",
	"type": "module",
	"svelteDraw_template": {
		"repo": "billyribeiro-ux/tl-svelte",
		"cli": {
			"name": "Shader",
			"description": "Create WebGL shaders that respond to shapes on the canvas.",
			"shortDescription": "Shaders on the canvas.",
			"order": 8
		},
		"scripts": {
			"lint": null,
			"build-types": null
		},
		"path": "templates/shader"
	},
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
		"lint": "pnpm exec tsx ../../internal/scripts/lint.ts",
		"build-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error"
	},
	"dependencies": {
		"@svelte-draw/assets": "workspace:*",
		"svelte-draw": "workspace:*"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "^8.0.16"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
