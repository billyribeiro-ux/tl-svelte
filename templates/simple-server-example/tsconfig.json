{
	"extends": "$app/tsconfig",
	"include": [
		"src",
		"vite.config.mts",
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		".svelte-kit/output",
		"src/server"
	],
	"compilerOptions": {
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"rootDirs": [
			".",
			"./.svelte-kit/types"
		],
		"types": [
			"vite/client",
			"$app/types"
		]
	}
}
