{
	"name": "svelte-draw-agent",
	"version": "0.0.0",
	"private": true,
	"homepage": "https://svelte-draw.invalid",
	"license": "MIT",
	"author": "billyribeiro-ux",
	"type": "module",
	"svelteDraw_template": {
		"repo": "billyribeiro-ux/tl-svelte",
		"cli": {
			"name": "Agent",
			"description": "Work on the canvas with an AI agent.",
			"shortDescription": "An AI-powered agent.",
			"order": 3
		},
		"deploy": {
			"target": "cloudflare",
			"host": "agent.templates.svelte-draw.invalid"
		},
		"scripts": {
			"lint": null,
			"build-types": null
		},
		"path": "templates/agent"
	},
	"scripts": {
		"build": "vite build",
		"dev": "node scripts/dev.mjs",
		"preview": "vite preview",
		"lint": "pnpm exec tsx ../../internal/scripts/lint.ts",
		"test": "pnpm exec vitest --passWithNoTests",
		"test-ci": "pnpm exec vitest run --passWithNoTests",
		"build-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
		"dev:client": "vite dev --host",
		"dev:worker": "wrangler dev --port 8787 --assets ./static",
		"deploy": "vite build && wrangler deploy"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^2.0.80",
		"@ai-sdk/google": "^2.0.74",
		"@ai-sdk/openai": "^2.0.106",
		"@google/generative-ai": "^0.24.1",
		"@svelte-draw/assets": "workspace:*",
		"@svelte-draw/editor": "workspace:*",
		"@svelte-draw/state": "workspace:*",
		"@svelte-draw/svelte": "workspace:*",
		"@svelte-draw/tlschema": "workspace:*",
		"@worker-tools/json-stream": "^0.1.0-pre.12",
		"ai": "^5.0.194",
		"best-effort-json-parser": "^1.1.3",
		"itty-router": "^5.0.18",
		"markdown-it": "^14.1.0",
		"svelte-draw": "workspace:*",
		"wrangler": "^4.75.0",
		"zod": "^4.1.8"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260302.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^22.16.0",
		"jsdom": "^29.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.0"
	},
	"imports": {
		"#lib/*": "./client/*"
	}
}
