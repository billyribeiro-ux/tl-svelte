{
	"name": "svelte-draw-sync-cloudflare",
	"private": true,
	"version": "0.0.0",
	"author": "billyribeiro-ux",
	"homepage": "https://svelte-draw.invalid",
	"license": "MIT",
	"type": "module",
	"svelteDraw_template": {
		"repo": "billyribeiro-ux/tl-svelte",
		"cli": {
			"name": "Multiplayer",
			"description": "Real-time multiplayer with a self-hosted backend.",
			"shortDescription": "Real-time multiplayer.",
			"order": 2
		},
		"deploy": {
			"target": "cloudflare",
			"host": "multiplayer.templates.svelte-draw.invalid"
		},
		"scripts": {
			"lint": null,
			"build-types": null
		},
		"path": "templates/sync-cloudflare"
	},
	"scripts": {
		"dev": "concurrently -k -n worker,client -c red,blue \"pnpm dev-worker\" \"pnpm dev-client\"",
		"dev-worker": "vite dev --config vite.worker.config.ts",
		"dev-client": "vite dev --host",
		"build": "vite build",
		"lint": "pnpm exec tsx ../../internal/scripts/lint.ts",
		"preview": "vite preview",
		"build-types": "svelte-kit sync && ! svelte-check --tsconfig ./tsconfig.json --threshold error --output machine | grep ' ERROR ' | grep -v '\"../../packages' && ! tsc -p worker/tsconfig.json | grep '^worker/'"
	},
	"dependencies": {
		"@svelte-draw/assets": "workspace:*",
		"@svelte-draw/sync": "workspace:*",
		"@svelte-draw/sync-core": "workspace:*",
		"@svelte-draw/tlschema": "workspace:*",
		"cloudflare-workers-unfurl": "^0.0.9",
		"itty-router": "^5.0.18",
		"svelte-draw": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.29.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"concurrently": "^9.1.2",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.75.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
