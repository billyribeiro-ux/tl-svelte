{{ define "svelte-draw.discord.title" -}}
{{ if eq .Status "firing" }}🔴{{ else }}✅{{ end }} {{ if gt (len .Alerts) 1 }}[{{ len .Alerts }} alerts] {{ end }}{{ template "svelte-draw.discord.short" (index .Alerts 0) }}
{{- end }}

{{ define "svelte-draw.discord.alert" -}}
{{ if eq .Labels.alertname "DatasourceNoData" -}}
⚠️ **No metrics** for **{{ .Labels.rulename }}** (usually the metrics source is down - for Zero rules: Fly.io metrics - not the alert condition itself)
{{- else -}}
{{ with .Labels.severity }}**{{ . | toUpper }}** · {{ end }}{{ template "svelte-draw.discord.short" . }}
{{- end }} · [View]({{ .GeneratorURL }}){{ with .DashboardURL }} · [Dashboard]({{ . }}){{ end }}
{{- end }}

{{ define "svelte-draw.discord.text" -}}
{{ range .Alerts.Firing }}{{ template "svelte-draw.discord.alert" . }}
{{ end -}}
{{ range .Alerts.Resolved }}✅ Resolved: {{ template "svelte-draw.discord.alert" . }}
{{ end -}}
{{- end }}
