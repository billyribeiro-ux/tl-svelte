{
	"name": "create-svelte-draw",
	"description": "svelte-draw infinite canvas SDK (create cli).",
	"version": "5.5.2",
	"author": "billyribeiro-ux",
	"homepage": "https://svelte-draw.invalid",
	"license": "SEE LICENSE IN LICENSE.md",
	"svelteDraw_product": {
		"stableId": "svelte-draw:create-svelte-draw",
		"name": "Create svelte-draw CLI",
		"type": "feature",
		"parent": "svelte-draw:sdk-core",
		"premium": false
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/billyribeiro-ux/tl-svelte"
	},
	"bugs": {
		"url": "https://github.com/billyribeiro-ux/tl-svelte/issues"
	},
	"keywords": [
		"svelte-draw",
		"sdk",
		"drawing",
		"app",
		"development",
		"whiteboard",
		"canvas",
		"infinite"
	],
	"bin": "./cli.cjs",
	"files": [
		"dist-cjs",
		"./cli.cjs"
	],
	"scripts": {
		"dev": "./scripts/dev.sh",
		"test-ci": "pnpm exec vitest run --passWithNoTests",
		"test": "pnpm exec vitest --passWithNoTests",
		"test-coverage": "pnpm exec vitest run --coverage --passWithNoTests",
		"build": "./scripts/build.sh",
		"prepack": "pnpm build",
		"pack-tarball": "pnpm pack",
		"lint": "pnpm exec tsx ../../internal/scripts/lint.ts",
		"build-types": "tsc --build"
	},
	"devDependencies": {
		"@bomb.sh/args": "^0.3.1",
		"@clack/core": "^1.0.0-alpha.1",
		"@clack/prompts": "^1.0.0-alpha.1",
		"@svelte-draw/utils": "workspace:*",
		"ansi-regex": "^6.1.0",
		"ansi-styles": "^6.2.1",
		"esbuild": "^0.28.0",
		"picocolors": "^1.1.1",
		"string-width": "^7.2.0",
		"strip-ansi": "^7.1.0",
		"tar": "^7.5.11"
	},
	"// because this is bundled, all dependencies should be dev dependencies.": null,
	"engines": {
		"node": ">=22.12.0"
	}
