{
	"name": "@svelte-draw/mentions",
	"description": "svelte-draw @-mention picker and TipTap node, shared by commenting and shape rich text.",
	"version": "5.5.2",
	"author": "billyribeiro-ux",
	"homepage": "https://svelte-draw.invalid",
	"license": "SEE LICENSE IN LICENSE.md",
	"svelteDraw_product": {
		"stableId": "svelte-draw:commenting",
		"name": "Commenting",
		"type": "feature",
		"parent": "svelte-draw:collaboration",
		"premium": true,
		"licenseFlag": "FEAT_COMMENTING"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/billyribeiro-ux/tl-svelte"
	},
	"bugs": {
		"url": "https://github.com/billyribeiro-ux/tl-svelte/issues"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"style": "./mentions.css",
	"type": "module",
	"files": [
		"mentions.css"
	],
	"scripts": {
		"test-ci": "pnpm exec vitest run --passWithNoTests",
		"test": "pnpm exec vitest --passWithNoTests",
		"test-coverage": "pnpm exec vitest run --coverage --passWithNoTests",
		"lint": "pnpm exec tsx ../../internal/scripts/lint.ts",
		"build-types": "svelte-check --tsconfig ./tsconfig.json --threshold error"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"svelte-draw": "workspace:*",
		"typescript": "6.0.3",
		"vitest": "^5.0.0"
	},
	"peerDependencies": {
		"svelte": "^5.57.1"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"dependencies": {
		"@svelte-draw/editor": "workspace:*",
		"@svelte-draw/svelte": "workspace:*",
		"@svelte-draw/utils": "workspace:*",
		"@tiptap/core": "^3.12.1",
		"@tiptap/extension-mention": "3.13.0",
		"@tiptap/pm": "^3.12.1",
		"@tiptap/suggestion": "3.13.0"
	},
	"svelte": "./src/index.ts"
}
