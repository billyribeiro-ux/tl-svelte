{
	"extends": ["$app/tsconfig", "../../internal/config/tsconfig.base.json"],
	"include": ["src", "e2e", "vite.config.ts", ".svelte-kit/ambient.d.ts", ".svelte-kit/non-ambient.d.ts", ".svelte-kit/types/**/$types.d.ts"],
	"exclude": ["node_modules", "dist", "**/*.css", ".tsbuild*", ".svelte-kit/output"],
	"compilerOptions": {
		"composite": false,
		"incremental": false,
		"declaration": false,
		"declarationMap": false,
		"emitDeclarationOnly": false,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noImplicitReturns": false,
		"rootDirs": [".", "./.svelte-kit/types"],
		"types": ["node", "vitest/globals", "$app/types"]
	}
}
