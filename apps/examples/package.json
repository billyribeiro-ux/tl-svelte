{
	"name": "examples.svelte-draw.invalid",
	"description": "svelte-draw infinite canvas SDK (examples).",
	"version": "0.0.0",
	"private": true,
	"author": "billyribeiro-ux",
	"homepage": "https://svelte-draw.invalid",
	"license": "SEE LICENSE IN LICENSE.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/billyribeiro-ux/tl-svelte"
	},
	"bugs": {
		"url": "https://github.com/billyribeiro-ux/tl-svelte/issues"
	},
	"keywords": [
		"svelte-draw",
		"sdk",
		"drawing",
		"app",
		"development",
		"whiteboard",
		"canvas",
		"infinite"
	],
	"scripts": {
		"dev": "vite dev --host",
		"preview": "vite preview --host",
		"build": "vite build",
		"lint": "pnpm exec tsx ../../internal/scripts/lint.ts",
		"e2e": "NODE_OPTIONS='--no-strip-types' playwright test -c ./e2e/playwright.config.ts ./e2e/tests/",
		"e2e-ui": "NODE_OPTIONS='--no-strip-types' playwright test --ui -c ./e2e/playwright.config.ts ./e2e/tests/",
		"e2e-perf": "NODE_OPTIONS='--no-strip-types' playwright test -c ./e2e/playwright.config.ts ./e2e/perf/",
		"e2e-perf-ui": "NODE_OPTIONS='--no-strip-types' playwright test --ui -c ./e2e/playwright.config.ts ./e2e/perf/",
		"e2e-mermaid-readability": "NODE_OPTIONS='--no-strip-types' playwright test -c ./e2e/playwright.config.ts ./e2e/mermaid-readability/ --project=chromium",
		"e2e-device-ios": "wdio run ./e2e-device/wdio.ios.conf.ts",
		"e2e-device-android": "wdio run ./e2e-device/wdio.android.conf.ts",
		"test": "pnpm exec vitest --passWithNoTests",
		"test-ci": "pnpm exec vitest run --passWithNoTests",
		"test-coverage": "pnpm exec vitest run --coverage --passWithNoTests",
		"build-types": "svelte-kit sync && ! svelte-check --tsconfig ./tsconfig.json --threshold error --output machine | grep ' ERROR ' | grep -v '\"../../packages'",
		"/* NOTE build-types */": "Examples declare custom shape types with `declare module`; svelte-check reads workspace package sources in the same program, so those augmentations widen types inside the packages. Package sources are checked by their own build-types; this gate covers only apps/examples."
	},
	"dependencies": {
		"@dimforge/rapier2d-compat": "^0.19.3",
		"@playwright/test": "^1.61.0",
		"@svelte-draw/assets": "workspace:*",
		"@svelte-draw/commenting": "workspace:*",
		"@svelte-draw/dotcom-shared": "workspace:*",
		"@svelte-draw/driver": "workspace:*",
		"@svelte-draw/editor": "workspace:*",
		"@svelte-draw/mermaid": "workspace:*",
		"@svelte-draw/state": "workspace:*",
		"@svelte-draw/svelte": "workspace:*",
		"@svelte-draw/sync": "workspace:*",
		"@svelte-draw/tlschema": "workspace:*",
		"@tiptap/core": "^3.12.1",
		"@tiptap/extension-font-family": "^3.12.1",
		"@tiptap/extension-text-style": "^3.12.1",
		"@tiptap/pm": "^3.12.1",
		"@tiptap/starter-kit": "^3.12.1",
		"ag-grid-community": "^32.3.3",
		"axe-core": "^4.10.3",
		"bits-ui": "2.19.5",
		"classnames": "^2.5.1",
		"d3-geo": "^3.1.1",
		"katex": "^0.18.1",
		"lodash": "^4.17.21",
		"mermaid": "11.16.1",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^4.10.38",
		"svelte-draw": "workspace:*",
		"topojson-client": "^3.1.0",
		"us-atlas": "^3.0.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/d3-geo": "^3.1.0",
		"@types/katex": "^0.16.8",
		"@types/lodash": "^4.17.14",
		"@types/topojson-client": "^3.1.5",
		"@types/topojson-specification": "^1.0.5",
		"@wdio/appium-service": "^9.0.0",
		"@wdio/cli": "^9.0.0",
		"@wdio/globals": "^9.0.0",
		"@wdio/local-runner": "^9.0.0",
		"@wdio/logger": "^9.0.0",
		"@wdio/mocha-framework": "^9.0.0",
		"@wdio/spec-reporter": "^9.0.0",
		"@wdio/types": "^9.0.0",
		"dotenv": "^16.4.7",
		"expect-webdriverio": "^5.6.8",
		"remark": "^15.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-html": "^16.0.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vfile-matter": "^5.0.0",
		"vite": "^8.0.16",
		"webdriverio": "^9.0.0"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
