{
	"name": "dotcom",
	"description": "The production app for svelte-draw.",
	"version": "0.0.0",
	"private": true,
	"author": "billyribeiro-ux",
	"browserslist": [
		"defaults"
	],
	"scripts": {
		"dev": "pnpm exec tsx scripts/dev-app.ts",
		"build": "pnpm exec tsx scripts/build.ts",
		"browser-run-thumbnail": "pnpm exec tsx scripts/browser-run-thumbnail.ts",
		"build-i18n": "pnpm run -w i18n-extract --project=dotcom",
		"start": "VITE_PREVIEW=1 pnpm exec tsx scripts/dev-app.ts",
		"lint": "pnpm exec tsx ../../../internal/scripts/lint.ts",
		"test-ci": "pnpm exec vitest run --passWithNoTests",
		"test": "pnpm exec vitest --passWithNoTests",
		"e2e": "rm -rf 'e2e/.auth' && NODE_OPTIONS='--no-strip-types' pnpm exec playwright test --project=chromium-scenarios",
		"e2e-scenarios": "NODE_OPTIONS='--no-strip-types' pnpm exec playwright test --project=chromium-scenarios",
		"e2e-smoke": "rm -rf 'e2e/.auth' && NODE_OPTIONS='--no-strip-types' pnpm exec playwright test --project=chromium",
		"e2e-all": "rm -rf 'e2e/.auth' && NODE_OPTIONS='--no-strip-types' pnpm exec playwright test --project=chromium --project=chromium-scenarios",
		"e2e-x10": "NODE_OPTIONS='--no-strip-types' pnpm exec playwright test --project=chromium-scenarios --repeat-each=10",
		"e2e-smoke-x10": "NODE_OPTIONS='--no-strip-types' pnpm exec playwright test --project=chromium --repeat-each=10",
		"e2e-all-x10": "NODE_OPTIONS='--no-strip-types' pnpm exec playwright test --project=chromium --project=chromium-scenarios --repeat-each=10",
		"e2e-debug": "NODE_OPTIONS='--no-strip-types' pnpm exec playwright test --project=chromium-scenarios --debug",
		"e2e-all-debug": "NODE_OPTIONS='--no-strip-types' pnpm exec playwright test --project=chromium --project=chromium-scenarios --debug",
		"e2e-ui": "NODE_OPTIONS='--no-strip-types' pnpm exec playwright test --project=chromium-scenarios --ui",
		"e2e-all-ui": "NODE_OPTIONS='--no-strip-types' pnpm exec playwright test --project=chromium --project=chromium-scenarios --ui",
		"e2e-staging": "NODE_OPTIONS='--no-strip-types' pnpm exec playwright test --project=staging",
		"e2e-both-modes": "./e2e/run-both-modes.sh",
		"test-coverage": "pnpm exec vitest run --coverage --passWithNoTests",
		"build-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error"
	},
	"dependencies": {
		"@clerk/clerk-js": "6.39.1",
		"@clerk/shared": "^4.40.0",
		"@rocicorp/zero": "1.10.0",
		"@sentry/browser": "^7.120.3",
		"@sentry/integrations": "^7.120.3",
		"@svelte-draw/assets": "workspace:*",
		"@svelte-draw/commenting": "workspace:*",
		"@svelte-draw/dotcom-shared": "workspace:*",
		"@svelte-draw/editor": "workspace:*",
		"@svelte-draw/mermaid": "workspace:*",
		"@svelte-draw/state": "workspace:*",
		"@svelte-draw/store": "workspace:*",
		"@svelte-draw/svelte": "workspace:*",
		"@svelte-draw/sync": "workspace:*",
		"@svelte-draw/sync-core": "workspace:*",
		"@svelte-draw/utils": "workspace:*",
		"axe-core": "^4.10.3",
		"bits-ui": "2.19.5",
		"browser-fs-access": "^0.35.0",
		"classnames": "^2.5.1",
		"idb": "^7.1.1",
		"intl-messageformat": "^11.1.2",
		"posthog-js": "^1.281.0",
		"qrcode": "^1.5.4",
		"svelte-draw": "workspace:*"
	},
	"devDependencies": {
		"@clerk/testing": "^2.2.33",
		"@formatjs/cli": "^6.5.1",
		"@formatjs/ts-transformer": "4.4.2",
		"@formatjs/unplugin": "^1.1.0",
		"@peculiar/webcrypto": "^1.5.0",
		"@playwright/test": "^1.61.0",
		"@sentry/cli": "^2.41.1",
		"@svelte-draw/validate": "workspace:*",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/md5": "^2.3.5",
		"@types/node": "^22.15.31",
		"@types/pg": "^8.16.0",
		"@types/qrcode": "^1.5.5",
		"@vercel/build-utils": "13.20.0",
		"dotenv": "^16.4.7",
		"fast-glob": "^3.3.3",
		"identity-obj-proxy": "^3.0.0",
		"jsdom": "^29.1.1",
		"json5": "^2.2.3",
		"kysely": "^0.28.12",
		"pg": "^8.16.3",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.0",
		"ws": "^8.18.0",
		"zod": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
