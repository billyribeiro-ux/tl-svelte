{
	"name": "@svelte-draw/docs",
	"description": "A docs site for svelte-draw.",
	"version": "0.0.0",
	"private": true,
	"author": "billyribeiro-ux",
	"homepage": "https://svelte-draw.invalid",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/billyribeiro-ux/tl-svelte"
	},
	"bugs": {
		"url": "https://github.com/billyribeiro-ux/tl-svelte/issues"
	},
	"keywords": [
		"svelte-draw",
		"sdk",
		"drawing",
		"app",
		"development",
		"whiteboard",
		"canvas",
		"infinite"
	],
	"scripts": {
		"dev": "concurrently \"NODE_ENV=development vite dev --port=3001\" \"tsx ./watcher.ts\" --kill-others",
		"next-dev": "vite dev",
		"lint": "pnpm exec tsx ../../internal/scripts/lint.ts",
		"build": "pnpm refresh-everything && pnpm check-links --fail && vite build",
		"start": "pnpm refresh-everything && vite preview",
		"fetch-api-source": "pnpm exec tsx --tsconfig ./tsconfig.content.json ./scripts/fetch-api-source.ts",
		"check-links": "pnpm exec tsx --tsconfig ./tsconfig.content.json ./scripts/check-broken-links.ts",
		"check-external-links": "pnpm exec tsx --tsconfig ./tsconfig.content.json ./scripts/check-external-links.ts",
		"create-api-markdown": "pnpm exec tsx --tsconfig ./tsconfig.content.json ./scripts/create-api-markdown.ts",
		"create-llms-txt": "pnpm exec tsx --tsconfig ./tsconfig.content.json ./scripts/create-llms-txt.ts",
		"refresh-content": "pnpm exec tsx --tsconfig ./tsconfig.content.json ./scripts/refresh-content.ts",
		"refresh-everything": "pnpm fetch-api-source && pnpm create-api-markdown && pnpm refresh-content && pnpm format && pnpm update-algolia-index",
		"refresh-api": "pnpm fetch-api-source && pnpm create-api-markdown && pnpm refresh-content && pnpm update-algolia-index",
		"update-algolia-index": "pnpm exec tsx --tsconfig ./tsconfig.content.json ./scripts/update-algolia-index.ts",
		"clean": "rm -rf node_modules .pnpm",
		"format": "pnpm exec oxfmt \"**/*.{js,jsx,ts,tsx,cjs,mjs,md,mdx,css,html,yml,yaml}\"",
		"watch-content": "tsx ./watcher.ts",
		"test-ci": "pnpm exec vitest run --passWithNoTests",
		"test": "pnpm exec vitest --passWithNoTests",
		"test-coverage": "pnpm exec vitest run --coverage --passWithNoTests",
		"build-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
		"preview": "vite preview",
		"check-redirects": "pnpm exec tsx ./scripts/write-vercel-redirects.ts"
	},
	"dependencies": {
		"@microsoft/api-extractor-model": "^7.30.2",
		"@microsoft/tsdoc": "0.15.1",
		"@shikijs/engine-javascript": "^1.29.1",
		"@shikijs/rehype": "^1.29.1",
		"@svelte-draw/assets": "workspace:*",
		"@svelte-draw/utils": "workspace:*",
		"algoliasearch": "^4.24.0",
		"bits-ui": "2.19.5",
		"clsx": "^2.1.1",
		"date-fns": "^3.6.0",
		"geist": "^1.3.1",
		"github-slugger": "^2.0.0",
		"google-auth-library": "^9.15.1",
		"gray-matter": "^4.0.3",
		"hast-util-to-html": "^9.0.4",
		"instantsearch.js": "^4.77.1",
		"property-information": "^6.4.0",
		"rehype-slug-custom-id": "^2.0.0",
		"remark": "^15.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.0",
		"remark-mdx": "^3.1.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.0",
		"rimraf": "^4.4.1",
		"shiki": "^1.29.1",
		"sqlite": "^5.1.1",
		"sqlite3": "^5.1.7",
		"tailwind-merge": "^2.6.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/typography": "^0.5.16",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"@types/node": "^22.15.31",
		"@types/sqlite3": "^3.1.11",
		"@types/ws": "^8.18.1",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.2",
		"dotenv": "^16.4.7",
		"jsdom": "^29.1.1",
		"mdast-util-mdx": "^3.0.0",
		"oxfmt": "^0.41.0",
		"patch-package": "^8.0.0",
		"postcss": "^8.5.1",
		"sharp": "^0.35.3",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tailwindcss": "^3.4.17",
		"tar": "^7.5.11",
		"tsx": "^4.19.2",
		"typescript": "6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.0",
		"ws": "^8.18.0"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*",
		"#utils/*": "./utils/*",
		"#types/*": "./types/*",
		"#scripts/*": "./scripts/*",
		"#root/*": "./*"
	}
}
